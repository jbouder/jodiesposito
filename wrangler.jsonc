{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jodiesposito",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "jodiesposito.com", "custom_domain": true },
    { "pattern": "www.jodiesposito.com", "custom_domain": true }
  ]
}
